// what NovaFix's add-on popup calls it. Without this it says the file name
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FFXIII Trilogy Patcher"
            VALUE "FileDescription",  "Mouse camera, strike and jump for Lightning Returns"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "lr_mouse"
            VALUE "OriginalFilename", "lr_mouse.asi"
            VALUE "ProductName",      "LR Mouse Support"
            VALUE "ProductVersion",   "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
