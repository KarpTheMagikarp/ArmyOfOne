// what NovaFix's add-on popup calls it. Without this it says the file name,
// which tells nobody it's the reason a Nova mod works
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FFXIII Trilogy Patcher"
            VALUE "FileDescription",  "Applies Nova Chrysalia code patches as the game starts"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "01_ff13_code_patches"
            VALUE "OriginalFilename", "01_ff13_code_patches.asi"
            VALUE "ProductName",      "Nova Chrysalia Code Patches"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
