// what NovaFix's add-on popup calls it. Without this it says the file name
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FFXIII Trilogy Patcher"
            VALUE "FileDescription",  "Clear voices, a clean stereo downmix and a quiet 7.1 for Final Fantasy XIII-2"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "xiii2_audio"
            VALUE "OriginalFilename", "xiii2_audio.asi"
            VALUE "ProductName",      "XIII-2 Audio Fix"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
